# --- Secrets ---
.env
.env.*
!.env.example

# --- Python / tooling ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Agent / editor scratch ---
.agents/
.claude/
~$*
~WRL*.tmp
*.tmp

